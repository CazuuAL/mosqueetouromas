# Variables d'environnement - Mosquée Al Kawthar

# Resend API Key pour l'envoi d'emails
RESEND_API_KEY=your_resend_api_key_here

# URL du site
SITE_URL=http://localhost:3000

# Identifiants du compte admin (/admin/login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploying

# Secret utilisé pour signer les tokens de session admin
# Générez une valeur aléatoire longue, par ex. avec : openssl rand -hex 32
ADMIN_TOKEN_SECRET=change-me-to-a-long-random-string
